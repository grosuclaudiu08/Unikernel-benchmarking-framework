spec: v0.6
name: nginx-native

unikraft:
  version: stable

libraries:
  musl: stable
  lwip: stable
  zlib: stable
  nginx: stable

targets:
  - architecture: x86_64
    platform: qemu

rootfs: ./rootfs

cmd: ["-c", "/conf/nginx.conf"]
cmd: ["-c", "/nginx/conf/nginx.conf"]

kconfig:
  CONFIG_LIBMUSL_AIO: n
  CONFIG_LIBVFSCORE_AUTOMOUNT_ROOTFS: y
  CONFIG_LIBVFSCORE_ROOTFS: '"ramfs"'
  CONFIG_LIBVFSCORE_ROOTFS_RAMFS: y
  CONFIG_LIBUKCPIO: y
  CONFIG_LIBVFSCORE_ROOTDEV: '"initrd0"'
  CONFIG_LIBVFSCORE_AUTOMOUNT_CI: y
  CONFIG_LIBVFSCORE_AUTOMOUNT_CI_CUSTOM: n
  CONFIG_LIBVFSCORE_AUTOMOUNT_CI_INITRD: y
